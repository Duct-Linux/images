# syntax=docker/dockerfile:1.7
#
# duct-live -- a bootable live ISO, assembled from Duct packages.
#
# Three stages, and the split between them is the interesting part:
#
#   assemble  installs the live package set into /rootfs with tape, exactly the
#             way Dockerfile.base does, then -- inside a chroot of that rootfs
#             -- builds the initramfs with Duct's busybox and links the EFI
#             bootloader with Duct's GRUB.
#
#   author    wraps the result: squashfs, a FAT image for the bootloader, and
#             an ISO around both. Debian tools, none of which ship.
#
#   export    a scratch image holding one file, so that
#             `--output type=local` drops the ISO on the host.
#
# The line between the second stage and the first is the whole design. What the
# firmware executes and what the machine runs are built by Duct; what packs
# them into a container is whatever the build host has, the same way buildx
# packs every other image here. Packaging xorriso, libburn, libisofs, mtools
# and dosfstools to move that line a little further would add five recipes that
# never run on a Duct machine.
#
#   make -C images iso
#
ARG BOOTSTRAP=ghcr.io/duct-linux/bootstrap:latest
ARG DEBIAN_DIGEST=sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# ---------------------------------------------------------------------------
# Stage 1 -- install the live package set into /rootfs, then build its boot
# tree from inside it.
# ---------------------------------------------------------------------------
FROM ${BOOTSTRAP} AS assemble

# The manifest. Overridable on purpose: this is the seam a desktop package set
# is layered in through, and adding one should be a different value here rather
# than a change to this file.
ARG PACKAGES="duct-filesystem linux-headers glibc zlib gmp mpfr mpc binutils gcc \
              ncurses bash uutils-coreutils tape \
              m4 bison flex make gawk sed grep findutils diffutils \
              tar gzip xz bzip2 patch file pkgconf perl texinfo \
              bc elfutils busybox kmod util-linux linux grub duct-live"

ARG REPO_NAME=duct
# A path rather than a URL by default. The published repository is the right
# source for duct/base -- it proves the publish works -- but an ISO is normally
# built from packages that have just been built and not yet published, and a
# local repository is also the only way to build one without a network.
ARG REPO_URL=/repo

USER root

# The trust anchor, and the one thing that has to match the repository being
# installed from. It arrives as a build context rather than from
# packages/server/ because a local repository is signed with the local key that
# `make -C ../packages key` generated, and the published one is not -- so
# hardcoding the production key here would make every local ISO build fail
# signature verification. The Makefile points this at packages/out/keys;
# building from the published repository means pointing it at packages/server.
COPY --from=ductkey duct.key.pub /etc/duct-assemble/keys/duct.pub

RUN set -eux; \
    install -d /etc/duct-assemble/repos; \
    { \
      echo '[daemon]'; \
      echo 'sysroot = "/rootfs"'; \
      echo 'installed-db = "/rootfs/var/lib/tape/installed.db"'; \
      echo 'socket = "/run/tape-assemble.sock"'; \
      echo 'cache-dir = "/var/cache/duct-assemble"'; \
    } > /etc/duct-assemble/config.toml; \
    { \
      echo '[repo]'; \
      echo 'name = "Duct"'; \
      printf 'baseurl = "%s"\n' "${REPO_URL}"; \
      echo 'enabled = true'; \
    } > /etc/duct-assemble/repos/${REPO_NAME}.toml

# One daemon for the whole transaction, as in Dockerfile.base.
#
# The repository is bind-mounted rather than copied in, for two reasons. It is
# several hundred megabytes and changes on every package build, so a COPY would
# put all of it in a layer and invalidate that layer constantly; and when
# REPO_URL is an https:// address instead of a path, the mount is simply never
# read, so the same Dockerfile builds both ways with nothing conditional in it.
RUN --mount=type=bind,from=ductrepo,target=/repo \
    set -eux; \
    export TAPE_CONFIG_DIR=/etc/duct-assemble; \
    install -d /rootfs /run; \
    taped & \
    daemon_pid=$!; \
    for i in $(seq 1 100); do [ -S /run/tape-assemble.sock ] && break; sleep 0.1; done; \
    [ -S /run/tape-assemble.sock ] || { echo "taped did not come up" >&2; exit 1; }; \
    tape install -y ${PACKAGES}; \
    status=$?; \
    kill "$daemon_pid"; wait "$daemon_pid" 2>/dev/null || true; \
    exit $status

# The repo definition and the key travel into the image, so the live system can
# update itself from the repository it came from -- as duct/base does.
#
# One consequence worth knowing: an ISO built from a *local* repository carries
# a baseurl of /repo, which existed only during this build. A live system from
# such an ISO cannot update itself, and `tape install` on it will fail looking
# for a directory that is not there. That is a development build. The ISO CI
# builds from https://repo.duct.dss-net.de with the key that signed it, and
# those can.
COPY images/iso/ /iso-tools/

RUN set -eux; \
    chmod +x /iso-tools/*.sh; \
    install -d /rootfs/etc/tape/repos /rootfs/etc/tape/keys /rootfs/var/cache/tape/repos; \
    cp /etc/duct-assemble/repos/${REPO_NAME}.toml /rootfs/etc/tape/repos/; \
    cp /etc/duct-assemble/keys/duct.pub /rootfs/etc/tape/keys/

# Everything tape cannot do itself: the linker cache, the modes its archiver
# cannot carry, and every cache that is keyed on the *set* of installed
# packages rather than on any one of them. See images/iso/post-install.sh --
# it is also the hook a larger package set extends, and it is written so that
# adding one needs no change here.
RUN /iso-tools/post-install.sh /rootfs

# The boot tree: initramfs and bootloader, both built by the rootfs's own
# programs under chroot. See images/iso/make-boot.sh.
RUN set -eux; \
    install -d /work/isoroot; \
    /iso-tools/make-boot.sh /rootfs /work/isoroot /iso-tools

# ---------------------------------------------------------------------------
# Stage 2 -- pack it.
#
# Pinned to the same Debian digest the bootstrap image uses, so the authoring
# host is as fixed as everything else. apt comes from the same snapshot for the
# same reason.
# ---------------------------------------------------------------------------
FROM debian@${DEBIAN_DIGEST} AS author

ARG DEBIAN_SNAPSHOT=20260801T000000Z
ARG SOURCE_DATE_EPOCH=1785542400
ARG VOLID=DUCT_LIVE
ARG COMPRESSION=zstd

ENV LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

# The same apt setup as Dockerfile's, and for the same reasons: the deb822
# sources file has to go or it overrides sources.list; http rather than https
# because bookworm-slim has no ca-certificates and a snapshot Release file is
# signed anyway; Error-Mode=any because apt-get update otherwise exits 0 after
# every source has failed.
#
# Pinning matters here even though none of these four tools ship. mksquashfs
# and xorriso decide the bytes of the output, so an unpinned authoring host
# would make two builds of identical packages produce different ISOs.
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    { \
      echo "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main"; \
      echo "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm-updates main"; \
      echo "deb http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main"; \
    } > /etc/apt/sources.list; \
    { \
      echo 'Acquire::Check-Valid-Until "false";'; \
      echo 'Acquire::Retries "5";'; \
      echo 'APT::Update::Error-Mode "any";'; \
    } > /etc/apt/apt.conf.d/10duct-snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        xorriso squashfs-tools dosfstools mtools faketime; \
    rm -rf /var/lib/apt/lists/*

COPY --from=assemble /rootfs /rootfs
COPY --from=assemble /work/isoroot /work/isoroot
COPY --from=assemble /work/boot.env /work/boot.env
COPY images/iso/build-iso.sh /iso-tools/build-iso.sh

RUN set -eux; \
    chmod +x /iso-tools/build-iso.sh; \
    install -d /out; \
    VOLID="${VOLID}" COMPRESSION="${COMPRESSION}" SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" \
      /iso-tools/build-iso.sh /rootfs /work/isoroot /work/boot.env /out/duct-live.iso

# ---------------------------------------------------------------------------
# Stage 3 -- one file, so `--output type=local` writes exactly that.
# ---------------------------------------------------------------------------
FROM scratch
COPY --from=author /out/duct-live.iso /
